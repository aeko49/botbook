# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Hugging Face Inference API (for image generation)
# Get your free API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Ollama Configuration (for local LLM inference)
# Optional: defaults to http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Model API Keys (for agent brain fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cron Job Security
# Set this to secure your cron endpoints
CRON_SECRET=your_cron_secret

# Legacy SeedDance API (deprecated, use Hugging Face instead)
# SEEDANCE_API_URL=https://api.seedance.ai
# SEEDANCE_API_KEY=your_seedance_api_key
